{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "capability_id",
    "operation_key",
    "operation",
    "job_id",
    "step_id",
    "attempt_id",
    "worker_run_id",
    "lease_epoch",
    "checkpoint_ids",
    "provenance_receipt_id",
    "created_at",
    "total_units",
    "run_snapshot_hash",
    "workspace_id",
    "document_id",
    "source_revision_id",
    "canonical_asset_id",
    "canonical_text_hash",
    "nodes",
    "taxonomy_asset_id",
    "taxonomy_asset_hash",
    "plot_template_asset_id",
    "plot_template_asset_hash",
    "model_profile_revision_id"
  ],
  "properties": {
    "schema": {
      "const": "analysis.narrative.unit.extract-request/v1"
    },
    "capability_id": {
      "const": "analysis.narrative.unit.extract/v1"
    },
    "operation_key": {
      "const": "analysis.narrative.unit.extract/v1"
    },
    "operation": {
      "enum": [
        "run",
        "resume",
        "cancel"
      ]
    },
    "job_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "step_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "worker_run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "lease_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "checkpoint_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "provenance_receipt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "created_at": {
      "type": "string",
      "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z|[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\\\.(?!000)[0-9]{3}Z)$"
    },
    "total_units": {
      "type": "integer",
      "minimum": 1
    },
    "run_snapshot_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "document_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "source_revision_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "known_parent_candidate_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "parent_receipt_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "skill_chain_result_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "chain_result_id",
          "asset_id",
          "asset_hash",
          "result_bundle_id",
          "result_item_id",
          "stream_id",
          "acked_prefix_hash"
        ],
        "properties": {
          "schema": {
            "const": "skill-chain-ref/v1"
          },
          "chain_result_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
          },
          "asset_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "asset_hash": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "result_bundle_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "result_item_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "stream_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "acked_prefix_hash": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "canonical_asset_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "canonical_text_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "start_codepoint",
          "end_codepoint"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
          },
          "start_codepoint": {
            "type": "integer",
            "minimum": 0
          },
          "end_codepoint": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "minItems": 1
    },
    "taxonomy_asset_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "taxonomy_asset_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "plot_template_asset_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "plot_template_asset_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "model_profile_revision_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "resume_checkpoint_asset_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "resume_checkpoint_asset_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "resume_state_asset_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "resume_state_asset_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "resume"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "required": [
          "resume_checkpoint_asset_id",
          "resume_checkpoint_asset_hash",
          "resume_state_asset_id",
          "resume_state_asset_hash"
        ]
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "analysis.narrative.unit.extract-request/v1",
  "title": "analysis.narrative.unit.extract-request/v1",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "template_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_plugin_id",
        "data_release_id",
        "package_hash",
        "format_id",
        "template_id"
      ],
      "properties": {
        "data_plugin_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "data_release_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "package_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "format_id": {
          "const": "plot-structure-template/v1"
        },
        "template_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        }
      }
    },
    "hierarchy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "parent_node_id",
        "level",
        "title",
        "unit_ids",
        "order"
      ],
      "properties": {
        "node_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "parent_node_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "level": {
          "enum": [
            "book",
            "volume",
            "chapter",
            "plot_unit"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "unit_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "order": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
