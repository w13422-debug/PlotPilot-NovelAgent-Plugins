            "entity_kind": {
              "enum": [
                "document",
                "node_structure",
                "relation_set"
              ]
            },
            "entity_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
            }
          }
        },
        "mutation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "payload_schema",
            "payload_hash"
