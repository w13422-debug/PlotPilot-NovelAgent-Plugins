                  {
                    "type": "null"
                  }
                ]
              },
              "source_type": {
                "type": "string",
                "minLength": 1
              },
              "source_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
