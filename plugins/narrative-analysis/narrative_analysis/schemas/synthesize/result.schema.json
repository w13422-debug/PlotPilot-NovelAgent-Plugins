            {
              "type": "null"
            }
          ]
        },
        "details_hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "workspace_id",
              "source_type",
              "source_id",
              "revision_or_hash"
            ],
            "properties": {
              "workspace_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "source_type": {
                "type": "string",
                "minLength": 1
              },
              "source_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
              },
              "revision_or_hash": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "status": {
          "enum": [
            "complete",
            "failed",
            "skipped"
          ]
