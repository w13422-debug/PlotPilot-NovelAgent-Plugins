    "base_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "contract_id",
        "bundle_id",
        "bundle_type",
        "producer",
        "input_snapshot_hash",
        "items",
        "warnings",
        "partial",
        "provenance_receipt_id",
        "skill_chain_result_refs"
