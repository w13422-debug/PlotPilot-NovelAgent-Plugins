{
  "$id": "https://plotpilot.local/schemas/style.refine-request-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "properties": {
    "schema": {"const": "style.refine-request/v1"}, "capability_id": {"const": "style.refine/v1"},
    "operation_key": {"const": "style.refine/v1"}, "operation": {"enum": ["run", "resume", "cancel"]},
    "job_id": {"$ref": "#/$defs/id"}, "step_id": {"$ref": "#/$defs/id"}, "attempt_id": {"$ref": "#/$defs/id"},
    "worker_run_id": {"$ref": "#/$defs/id"}, "lease_epoch": {"type": "integer", "minimum": 1},
    "checkpoint_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "provenance_receipt_id": {"$ref": "#/$defs/id"}, "created_at": {"type": "string"},
    "total_units": {"type": "integer", "minimum": 1}, "run_snapshot_hash": {"$ref": "#/$defs/hash"},
    "workspace_id": {"$ref": "#/$defs/id"}, "document_id": {"$ref": "#/$defs/id"}, "source_revision_id": {"$ref": "#/$defs/id"},
    "source_asset_id": {"$ref": "#/$defs/id"}, "source_content_hash": {"$ref": "#/$defs/hash"},
    "style_pack_asset_id": {"$ref": "#/$defs/id"}, "style_pack_asset_hash": {"$ref": "#/$defs/hash"},
    "qualification_receipt_asset_id": {"$ref": "#/$defs/id"}, "qualification_receipt_asset_hash": {"$ref": "#/$defs/hash"},
    "model_profile_revision_id": {"$ref": "#/$defs/id"}, "quality_rubric_asset_id": {"$ref": "#/$defs/id"},
    "quality_rubric_asset_hash": {"$ref": "#/$defs/hash"}, "review_result_asset_id": {"$ref": "#/$defs/id"},
    "review_result_asset_hash": {"$ref": "#/$defs/hash"}, "known_parent_candidate_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "candidate_count": {"type": "integer", "minimum": 1, "maximum": 8},
    "resume_checkpoint_asset_id": {"$ref": "#/$defs/id"}, "resume_checkpoint_asset_hash": {"$ref": "#/$defs/hash"},
    "resume_state_asset_id": {"$ref": "#/$defs/id"}, "resume_state_asset_hash": {"$ref": "#/$defs/hash"}
  },
  "required": ["schema", "capability_id", "operation_key", "operation", "job_id", "step_id", "attempt_id", "worker_run_id", "lease_epoch", "checkpoint_ids", "provenance_receipt_id", "created_at", "total_units", "run_snapshot_hash", "workspace_id", "document_id", "source_revision_id", "source_asset_id", "source_content_hash", "style_pack_asset_id", "style_pack_asset_hash", "qualification_receipt_asset_id", "qualification_receipt_asset_hash", "model_profile_revision_id", "quality_rubric_asset_id", "quality_rubric_asset_hash", "review_result_asset_id", "review_result_asset_hash", "known_parent_candidate_ids", "candidate_count"],
  "allOf": [{"if": {"properties": {"operation": {"const": "resume"}}}, "then": {"required": ["resume_checkpoint_asset_id", "resume_checkpoint_asset_hash", "resume_state_asset_id", "resume_state_asset_hash"]}, "else": {"not": {"anyOf": [{"required": ["resume_checkpoint_asset_id"]}, {"required": ["resume_checkpoint_asset_hash"]}, {"required": ["resume_state_asset_id"]}, {"required": ["resume_state_asset_hash"]}]}}}],
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"}, "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
