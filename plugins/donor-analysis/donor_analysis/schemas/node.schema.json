{
  "$id": "book-analysis-node/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "node_id",
    "start_codepoint",
    "end_codepoint"
  ],
  "properties": {
    "node_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "start_codepoint": {
      "type": "integer",
      "minimum": 0
    },
    "end_codepoint": {
      "type": "integer",
      "minimum": 1
    }
  }
}
