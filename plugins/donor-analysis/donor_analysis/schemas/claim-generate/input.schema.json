                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "schema",
                    "workspace_id",
                    "document_id",
                    "revision_id",
                    "node_id",
                    "start_codepoint",
                    "end_codepoint",
                    "quote",
                    "quote_hash",
                    "canonical_text_hash"
                  ],
                  "properties": {
                    "schema": {
                      "const": "evidence-span/v1"
                    },
                    "workspace_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
                    },
                    "document_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
                    },
                    "revision_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
                    },
                    "node_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
                    },
                    "start_codepoint": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "end_codepoint": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1
                    },
                    "quote_hash": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "canonical_text_hash": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  }
                },
                "minItems": 1
              }
            }
          }
        },
        "model_profile_revision_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "snapshot_parameters_asset_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "snapshot_asset_hashes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "asset_id",
              "sha256"
            ],
            "properties": {
              "asset_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "canonical_asset_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "canonical_text_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$id": "book-analysis-node/v1",
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "node_id",
              "start_codepoint",
              "end_codepoint"
            ],
            "properties": {
              "node_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
              },
              "start_codepoint": {
                "type": "integer",
                "minimum": 0
              },
              "end_codepoint": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    }
  ]
}
