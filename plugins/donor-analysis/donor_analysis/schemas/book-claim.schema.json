{
  "$id": "book-claim/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "category",
    "title",
    "claim",
    "scope",
    "applicability",
    "counterexamples",
    "conflicts",
    "interpretation_confidence",
    "ordered_atom_ids",
    "evidence_spans",
    "analysis_method",
    "prompt_eligible",
    "promotion_authorized",
    "authority"
  ],
  "properties": {
    "schema": {
      "const": "book-claim/v1"
    },
    "category": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string"
    },
    "applicability": {
      "type": "string"
    },
    "counterexamples": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "interpretation_confidence": {
      "enum": [
        "inferred",
        "uncertain",
        "conflict"
      ]
    },
    "ordered_atom_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
      }
    },
    "evidence_spans": {
      "type": "array",
      "items": {
        "$id": "evidence-span/v1",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "workspace_id",
          "document_id",
          "revision_id",
          "node_id",
          "start_codepoint",
          "end_codepoint",
          "quote",
          "quote_hash",
          "canonical_text_hash"
        ],
        "properties": {
          "schema": {
            "const": "evidence-span/v1"
          },
          "workspace_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
          },
          "document_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
          },
          "revision_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
          },
          "node_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
          },
          "start_codepoint": {
            "type": "integer",
            "minimum": 0
          },
          "end_codepoint": {
            "type": "integer",
            "minimum": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "quote_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "canonical_text_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "minItems": 1
    },
    "analysis_method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "book-claim-generate"
        },
        "version": {
          "const": "1"
        }
      }
    },
    "prompt_eligible": {
      "const": false
    },
    "promotion_authorized": {
      "const": false
    },
    "authority": {
      "const": "candidate_only"
    }
  }
}
