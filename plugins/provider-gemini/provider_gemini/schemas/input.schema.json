{
  "$id": "model.provider.gemini.invoke-request/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "model.provider.gemini.invoke-request/v1" },
    "invocation_id": { "$ref": "#/$defs/id" },
    "worker_run_id": { "$ref": "#/$defs/id" },
    "job_id": { "$ref": "#/$defs/id" },
    "step_id": { "$ref": "#/$defs/id" },
    "attempt_id": { "$ref": "#/$defs/id" },
    "lease_epoch": { "type": "integer", "minimum": 1 },
    "run_snapshot_hash": { "$ref": "#/$defs/hash" },
    "model": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/message" }
    },
    "prompt": { "type": "string", "minLength": 1 },
    "max_tokens": { "type": "integer", "minimum": 1 },
    "temperature": { "type": "number" },
    "stream": { "const": true },
    "output_role": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$" },
    "target": { "$ref": "#/$defs/target" },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "stream_id": { "$ref": "#/$defs/id" },
    "checkpoint_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "provenance_receipt_id": { "$ref": "#/$defs/id" },
    "response_mime": { "type": "string", "minLength": 1 },
    "total_units": { "type": ["integer", "null"], "minimum": 0 },
    "response_format": { "$ref": "#/$defs/responseFormat" }
  },
  "required": [
    "schema", "invocation_id", "worker_run_id", "job_id", "step_id", "attempt_id",
    "lease_epoch", "run_snapshot_hash", "model", "messages", "max_tokens",
    "temperature", "stream", "output_role", "target", "created_at", "stream_id",
    "checkpoint_ids", "provenance_receipt_id"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": {
      "type": "string",
      "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z|[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.(?!000)[0-9]{3}Z)$"
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": { "enum": ["system", "user", "assistant"] },
        "content": { "type": "string", "minLength": 1 }
      },
      "required": ["role", "content"]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workspace_id": { "$ref": "#/$defs/id" },
        "entity_kind": { "enum": ["document", "node_structure", "relation_set"] },
        "entity_id": { "$ref": "#/$defs/id" }
      },
      "required": ["workspace_id", "entity_kind", "entity_id"]
    },
    "responseFormat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["text", "json", "json_object"] }
      },
      "required": ["type"]
    }
  }
}
