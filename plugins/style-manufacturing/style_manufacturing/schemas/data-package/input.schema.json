        "schema": {
          "const": "style.data-plugin.package-request/v1"
        },
        "capability_id": {
          "const": "style.data-plugin.package/v1"
        },
        "operation_key": {
          "const": "style.data-plugin.package/v1"
        },
        "operation": {
          "const": "run"
        },
        "job_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "step_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "attempt_id": {
