{
  "$id": "style.chunk-plan/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "style_pack_id",
    "source_asset_id",
    "source_asset_hash",
    "source_revision_id",
    "chunk_plan_hash",
    "chunks"
  ],
  "properties": {
    "schema": {
      "const": "style.chunk-plan/v1"
    },
    "style_pack_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "source_asset_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "source_asset_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_revision_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "chunk_plan_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "chunk_id",
          "ordinal",
          "offset",
          "length",
          "content_hash",
          "text"
        ],
        "properties": {
          "chunk_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
          },
          "ordinal": {
            "type": "integer",
            "minimum": 0
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "length": {
            "type": "integer",
            "minimum": 0
          },
          "content_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "text": {
            "type": "string"
          }
        }
      }
    }
  }
}
