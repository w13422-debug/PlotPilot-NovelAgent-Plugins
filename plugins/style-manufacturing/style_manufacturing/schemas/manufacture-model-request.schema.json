{
  "$id": "style.manufacture-model-request/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_asset_id",
    "source_asset_hash",
    "source_revision_id",
    "target_cas",
    "route_id",
    "prompt_hash",
    "output_schema_hash",
    "chunk_plan_hash",
    "lexicon_bindings",
    "output_schema",
    "run_snapshot_hash",
    "model_profile_revision_id",
    "attempt_ids"
  ],
  "properties": {
    "schema": {
      "const": "style.manufacture-model-request/v1"
    },
    "source_asset_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "source_asset_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_revision_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "target_cas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_id",
        "entity_id",
        "base_revision_id",
        "base_content_hash"
      ],
      "properties": {
        "workspace_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "entity_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "base_revision_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "base_content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "route_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "prompt_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "output_schema_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "chunk_plan_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "lexicon_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data_plugin_id",
          "data_release_id",
          "bundle_hash",
          "order",
          "asset_hash"
        ],
        "properties": {
          "data_plugin_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
          },
          "data_release_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bundle_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "asset_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "output_schema": {
      "const": "style.manufacture-model-response/v1"
    },
    "run_snapshot_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "model_profile_revision_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "attempt_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
      }
    },
    "phase": {
      "enum": [
        "map",
        "synthesis"
      ]
    },
    "chunk_plan_asset_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "chunk_plan_asset_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chunk_id",
        "ordinal",
        "offset",
        "length",
        "content_hash",
        "text"
      ],
      "properties": {
        "chunk_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "length": {
          "type": "integer",
          "minimum": 0
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "map_records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "chunk_id",
          "ordinal",
          "map_record_asset_id",
          "map_record_asset_hash",
          "map_output_asset_id",
          "map_output_asset_hash",
          "model_receipt_id"
        ],
        "properties": {
          "chunk_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
          },
          "ordinal": {
            "type": "integer",
            "minimum": 0
          },
          "map_record_asset_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
          },
          "map_record_asset_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "map_output_asset_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
          },
          "map_output_asset_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "model_receipt_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
          }
        }
      }
    }
  }
}
