{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "asset.data-plugin.package/v1 request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "asset.data-plugin.package-request/v1"
    },
    "capability_id": {
      "const": "asset.data-plugin.package/v1"
    },
    "operation_key": {
      "const": "asset.data-plugin.package/v1"
    },
    "operation": {
      "enum": [
        "run",
        "resume",
        "cancel",
        "validate"
      ]
    },
    "job_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "step_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "worker_run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "lease_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "checkpoint_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
      },
      "uniqueItems": true
    },
    "provenance_receipt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "created_at": {
      "type": "string",
      "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z|[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.(?!000)[0-9]{3}Z)$"
    },
    "total_units": {
      "type": "integer",
      "minimum": 1
    },
    "run_snapshot_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "format_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "data_plugin_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.0\\.0$"
    },
    "root_path": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "asset_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "mime": {
            "type": "string",
            "minLength": 1
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "path",
          "asset_id",
          "sha256",
          "mime",
          "size"
        ]
      },
      "uniqueItems": true
    },
    "package_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "release_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "interpreter_mappings": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "format_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
          },
          "plugin_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
          },
          "capability_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
          },
          "direction": {
            "enum": [
              "format_to_capability",
              "capability_to_format"
            ]
          }
        },
        "required": [
          "format_id",
          "plugin_id",
          "capability_id",
          "direction"
        ]
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema",
    "capability_id",
    "operation_key",
    "operation",
    "job_id",
    "step_id",
    "attempt_id",
    "worker_run_id",
    "lease_epoch",
    "checkpoint_ids",
    "provenance_receipt_id",
    "created_at",
    "total_units",
    "run_snapshot_hash",
    "workspace_id",
    "format_id",
    "data_plugin_id",
    "version",
    "root_path",
    "files",
    "package_hash",
    "release_id",
    "interpreter_mappings"
  ]
}
