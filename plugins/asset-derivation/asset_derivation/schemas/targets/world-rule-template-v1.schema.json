{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plotpilot.local/data/world-rule-template-v1",
  "title": "PlotPilot world-rule-template/v1 frozen closed Data schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "world-rule-template/v1"
    },
    "format_id": {
      "const": "world-rule-template/v1"
    },
    "template_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.0\\.0$"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,63}$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "integer",
            "minimum": 0
          },
          "exceptions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "rule_id",
          "statement",
          "scope",
          "priority",
          "exceptions"
        ]
      },
      "uniqueItems": true
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "constraint_kinds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,63}$"
      },
      "uniqueItems": true
    },
    "interpreter_mappings": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "format_id": {
            "const": "world-rule-template/v1"
          },
          "plugin_id": {
            "type": "string",
            "minLength": 1
          },
          "capability_id": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "enum": [
              "format_to_capability",
              "capability_to_format"
            ]
          }
        },
        "required": [
          "format_id",
          "plugin_id",
          "capability_id",
          "direction"
        ]
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema",
    "format_id",
    "template_id",
    "version",
    "rules",
    "invariants",
    "constraint_kinds",
    "interpreter_mappings"
  ]
}
