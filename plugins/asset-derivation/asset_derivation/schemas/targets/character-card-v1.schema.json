{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Character card target",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "character-card/v1"
    },
    "format_id": {
      "const": "character-card/v1"
    },
    "character_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "identity": {
      "type": "string",
      "minLength": 1
    },
    "goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "motivations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "fears": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "abilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "flaws": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "relation_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
          },
          "kind": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
          },
          "from_character_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
          },
          "to_character_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "evidence_spans": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "schema": {
                  "const": "evidence-span/v1"
                },
                "workspace_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
                },
                "document_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
                },
                "revision_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
                },
                "node_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
                },
                "start_codepoint": {
                  "type": "integer",
                  "minimum": 0
                },
                "end_codepoint": {
                  "type": "integer",
                  "minimum": 0
                },
                "quote": {
                  "type": "string"
                },
                "quote_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "canonical_text_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "schema",
                "workspace_id",
                "document_id",
                "revision_id",
                "node_id",
                "start_codepoint",
                "end_codepoint",
                "quote",
                "quote_hash",
                "canonical_text_hash"
              ]
            }
          }
        },
        "required": [
          "relation_id",
          "kind",
          "from_character_id",
          "to_character_id",
          "label",
          "evidence_spans"
        ]
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "arc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stage": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
          }
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "key_events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "stage",
        "stages",
        "summary",
        "key_events"
      ]
    },
    "speech_habits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "behavior_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema": {
            "const": "evidence-span/v1"
          },
          "workspace_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
          },
          "document_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
          },
          "revision_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
          },
          "node_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
          },
          "start_codepoint": {
            "type": "integer",
            "minimum": 0
          },
          "end_codepoint": {
            "type": "integer",
            "minimum": 0
          },
          "quote": {
            "type": "string"
          },
          "quote_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "canonical_text_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "schema",
          "workspace_id",
          "document_id",
          "revision_id",
          "node_id",
          "start_codepoint",
          "end_codepoint",
          "quote",
          "quote_hash",
          "canonical_text_hash"
        ]
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "workspace_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
          },
          "document_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
          },
          "revision_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
          }
        },
        "required": [
          "workspace_id",
          "document_id",
          "revision_id"
        ]
      }
    },
    "authority": {
      "const": "candidate_only"
    }
  },
  "required": [
    "schema",
    "format_id",
    "character_id",
    "name",
    "identity",
    "goals",
    "motivations",
    "fears",
    "abilities",
    "flaws",
    "relationships",
    "conflicts",
    "arc",
    "speech_habits",
    "behavior_evidence",
    "source_refs",
    "authority"
  ]
}
