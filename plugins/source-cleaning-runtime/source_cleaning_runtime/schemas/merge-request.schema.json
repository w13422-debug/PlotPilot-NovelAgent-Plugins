{
  "$id": "source.clean.rules.merge-request/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "operation_key", "operation", "job_id", "step_id", "attempt_id", "worker_run_id", "lease_epoch", "checkpoint_ids", "provenance_receipt_id", "created_at", "total_units", "run_snapshot_hash", "workspace_id", "rules_packages"],
  "properties": {
    "schema": { "const": "source.clean.rules.merge-request/v1" },
    "operation_key": { "const": "source.clean.rules.merge/v1" },
    "operation": { "enum": ["run", "validate"] },
    "job_id": { "$ref": "#/$defs/id" }, "step_id": { "$ref": "#/$defs/id" }, "attempt_id": { "$ref": "#/$defs/id" }, "worker_run_id": { "$ref": "#/$defs/id" },
    "lease_epoch": { "type": "integer", "minimum": 1 }, "checkpoint_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "provenance_receipt_id": { "$ref": "#/$defs/id" }, "created_at": { "type": "string", "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z|[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.(?!000)[0-9]{3}Z)$" }, "total_units": { "type": "integer", "minimum": 0 },
    "run_snapshot_hash": { "$ref": "#/$defs/hash" }, "workspace_id": { "$ref": "#/$defs/id" },
    "rules_packages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/package" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "rule": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "description", "pattern", "scope", "target", "input_kinds", "flags", "enabled", "order", "tags"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "name": { "type": "string", "minLength": 1 }, "description": { "type": "string" }, "pattern": { "type": "string", "minLength": 1 },
        "scope": { "enum": ["line", "paragraph", "chapter"] }, "target": { "enum": ["body", "title"] },
        "input_kinds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["txt", "epub", "paste", "all"] } },
        "flags": { "type": "array", "uniqueItems": true, "items": { "enum": ["ignore_case", "multiline", "dotall"] } }, "enabled": { "type": "boolean" }, "order": { "type": "integer", "minimum": 0 }, "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "rules": { "type": "object", "additionalProperties": false, "required": ["schema", "rules"], "properties": { "schema": { "const": "source-cleaning-rules/v1" }, "rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rule" } } } },
    "package": {
      "type": "object", "additionalProperties": false, "required": ["package_id", "version", "release_id", "package_hash", "rules"],
      "properties": { "package_id": { "$ref": "#/$defs/id" }, "version": { "type": "string", "minLength": 1 }, "release_id": { "$ref": "#/$defs/hash" }, "package_hash": { "$ref": "#/$defs/hash" }, "rules": { "$ref": "#/$defs/rules" } }
    }
  }
}
