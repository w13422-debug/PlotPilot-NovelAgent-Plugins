{
  "$id": "model.provider.anthropic.invoke-result/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": { "enum": ["succeeded", "failed", "cancelled"] },
    "result": { "anyOf": [{ "$ref": "#/$defs/artifactBundle" }, { "type": "null" }] },
    "conditional_result": { "anyOf": [{ "$ref": "#/$defs/diagnosticBundle" }, { "type": "null" }] },
    "receipt": { "$ref": "#/$defs/receipt" },
    "error": { "anyOf": [{ "$ref": "#/$defs/error" }, { "type": "null" }] },
    "chunks": { "type": "array", "items": { "$ref": "#/$defs/chunk" } },
    "output_text": { "type": "string" }
  },
  "required": ["status", "result", "conditional_result", "receipt", "error", "chunks", "output_text"],
  "oneOf": [
    {
      "properties": {
        "status": { "const": "succeeded" },
        "result": { "$ref": "#/$defs/artifactBundle" },
        "conditional_result": { "type": "null" },
        "error": { "type": "null" }
      }
    },
    {
      "properties": {
        "status": { "const": "failed" },
        "result": { "type": "null" },
        "conditional_result": { "anyOf": [{ "$ref": "#/$defs/diagnosticBundle" }, { "type": "null" }] },
        "error": { "$ref": "#/$defs/error" }
      }
    },
    {
      "properties": {
        "status": { "const": "cancelled" },
        "result": { "type": "null" },
        "conditional_result": { "type": "null" },
        "error": { "$ref": "#/$defs/error" }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plugin_id": { "$ref": "#/$defs/id" },
        "release_id": { "$ref": "#/$defs/hash" },
        "capability_id": { "$ref": "#/$defs/id" },
        "job_id": { "$ref": "#/$defs/id" },
        "step_id": { "$ref": "#/$defs/id" },
        "attempt_id": { "$ref": "#/$defs/id" },
        "lease_epoch": { "type": "integer", "minimum": 1 }
      },
      "required": ["plugin_id", "release_id", "capability_id", "job_id", "step_id", "attempt_id", "lease_epoch"]
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workspace_id": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "source_type": { "type": "string", "minLength": 1 },
        "source_id": { "$ref": "#/$defs/id" },
        "revision_or_hash": { "type": "string", "minLength": 1 }
      },
      "required": ["workspace_id", "source_type", "source_id", "revision_or_hash"]
    },
    "artifactItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "artifact-item/v1" },
        "item_id": { "$ref": "#/$defs/id" },
        "artifact_kind": { "$ref": "#/$defs/id" },
        "payload_asset_id": { "$ref": "#/$defs/id" },
        "payload_hash": { "$ref": "#/$defs/hash" },
        "mime": { "type": "string", "minLength": 1 },
        "source_refs": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" } },
        "status": { "enum": ["complete", "partial", "failed", "skipped"] }
      },
      "required": ["schema", "item_id", "artifact_kind", "payload_asset_id", "payload_hash", "mime", "source_refs", "status"]
    },
    "diagnosticItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "diagnostic-item/v1" },
        "item_id": { "$ref": "#/$defs/id" },
        "severity": { "enum": ["info", "warning", "error"] },
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string" },
        "details_asset_id": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "details_hash": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
        "source_refs": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" } },
        "status": { "enum": ["complete", "failed", "skipped"] }
      },
      "required": ["schema", "item_id", "severity", "code", "message", "details_asset_id", "details_hash", "source_refs", "status"]
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string" },
        "details_asset_id": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }
      },
      "required": ["code", "message", "details_asset_id"]
    },
    "skillRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "skill-chain-ref/v1" },
        "chain_result_id": { "$ref": "#/$defs/id" },
        "asset_id": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "asset_hash": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
        "result_bundle_id": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "result_item_id": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "stream_id": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "acked_prefix_hash": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] }
      },
      "required": ["schema", "chain_result_id", "asset_id", "asset_hash", "result_bundle_id", "result_item_id", "stream_id", "acked_prefix_hash"]
    },
    "artifactBundle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "result-bundle/v1" },
        "contract_id": { "const": "artifact-bundle/v1" },
        "bundle_id": { "$ref": "#/$defs/id" },
        "bundle_type": { "const": "artifact" },
        "producer": { "$ref": "#/$defs/producer" },
        "input_snapshot_hash": { "$ref": "#/$defs/hash" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/artifactItem" }, "minItems": 1 },
        "warnings": { "type": "array", "items": { "$ref": "#/$defs/warning" } },
        "partial": { "const": false },
        "provenance_receipt_id": { "$ref": "#/$defs/id" },
        "skill_chain_result_refs": { "type": "array", "items": { "$ref": "#/$defs/skillRef" } }
      },
      "required": ["schema", "contract_id", "bundle_id", "bundle_type", "producer", "input_snapshot_hash", "items", "warnings", "partial", "provenance_receipt_id", "skill_chain_result_refs"]
    },
    "diagnosticBundle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "result-bundle/v1" },
        "contract_id": { "const": "diagnostic-bundle/v1" },
        "bundle_id": { "$ref": "#/$defs/id" },
        "bundle_type": { "const": "diagnostic" },
        "producer": { "$ref": "#/$defs/producer" },
        "input_snapshot_hash": { "$ref": "#/$defs/hash" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/diagnosticItem" }, "minItems": 1 },
        "warnings": { "type": "array", "items": { "$ref": "#/$defs/warning" } },
        "partial": { "const": true },
        "provenance_receipt_id": { "$ref": "#/$defs/id" },
        "skill_chain_result_refs": { "type": "array", "items": { "$ref": "#/$defs/skillRef" } }
      },
      "required": ["schema", "contract_id", "bundle_id", "bundle_type", "producer", "input_snapshot_hash", "items", "warnings", "partial", "provenance_receipt_id", "skill_chain_result_refs"]
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "provenance-receipt/v1" },
        "receipt_id": { "$ref": "#/$defs/id" },
        "plugin_id": { "$ref": "#/$defs/id" },
        "release_id": { "$ref": "#/$defs/hash" },
        "package_hash": { "$ref": "#/$defs/hash" },
        "capability_id": { "$ref": "#/$defs/id" },
        "job_id": { "$ref": "#/$defs/id" },
        "step_id": { "$ref": "#/$defs/id" },
        "attempt_id": { "$ref": "#/$defs/id" },
        "lease_epoch": { "type": "integer", "minimum": 1 },
        "run_snapshot_hash": { "$ref": "#/$defs/hash" },
        "bundle_id": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "bundle_hash": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
        "parent_receipt_ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "model_receipt_ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "skill_chain_result_refs": { "type": "array", "items": { "$ref": "#/$defs/skillRef" } },
        "staged_items": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "created_at": { "type": "string", "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z|[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.(?!000)[0-9]{3}Z)$" },
        "receipt_hash": { "$ref": "#/$defs/hash" }
      },
      "required": ["schema", "receipt_id", "plugin_id", "release_id", "package_hash", "capability_id", "job_id", "step_id", "attempt_id", "lease_epoch", "run_snapshot_hash", "bundle_id", "bundle_hash", "parent_receipt_ids", "model_receipt_ids", "skill_chain_result_refs", "staged_items", "created_at", "receipt_hash"]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" }
      },
      "required": ["code", "message", "retryable"]
    },
    "streamPrefix": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "stream-prefix/v1" },
        "stream_id": { "$ref": "#/$defs/id" },
        "job_id": { "$ref": "#/$defs/id" },
        "step_id": { "$ref": "#/$defs/id" },
        "output_role": { "$ref": "#/$defs/id" },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "workspace_id": { "$ref": "#/$defs/id" },
            "entity_kind": { "enum": ["document", "node_structure", "relation_set"] },
            "entity_id": { "$ref": "#/$defs/id" }
          },
          "required": ["workspace_id", "entity_kind", "entity_id"]
        },
        "attempt_id": { "$ref": "#/$defs/id" },
        "lease_epoch": { "type": "integer", "minimum": 1 },
        "prefix_seq": { "type": "integer", "minimum": 1 },
        "prefix_asset_id": { "$ref": "#/$defs/id" },
        "prefix_hash": { "$ref": "#/$defs/hash" },
        "byte_length": { "type": "integer", "minimum": 0 },
        "encoding": { "const": "utf-8" }
      },
      "required": ["schema", "stream_id", "job_id", "step_id", "output_role", "target", "attempt_id", "lease_epoch", "prefix_seq", "prefix_asset_id", "prefix_hash", "byte_length", "encoding"]
    },
    "chunk": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seq": { "type": "integer", "minimum": 1 },
        "delta": { "type": "string", "minLength": 1 },
        "prefix": { "type": "string", "minLength": 1 },
        "prefix_hash": { "$ref": "#/$defs/hash" },
        "usage": {
          "anyOf": [
            { "type": "null" },
            { "type": "object", "additionalProperties": false, "properties": { "input_tokens": { "type": "integer", "minimum": 0 }, "output_tokens": { "type": "integer", "minimum": 0 } }, "required": [] }
          ]
        },
        "prefix_asset_id": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "stream_prefix": { "anyOf": [{ "$ref": "#/$defs/streamPrefix" }, { "type": "null" }] }
      },
      "required": ["seq", "delta", "prefix", "prefix_hash", "usage", "prefix_asset_id", "stream_prefix"]
    }
  }
}
