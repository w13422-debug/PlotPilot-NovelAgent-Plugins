{
  "$id":"source.evidence.search-result/v1",
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object","additionalProperties":false,
  "required":["schema","contract_id","bundle_id","bundle_type","producer","input_snapshot_hash","items","warnings","partial","provenance_receipt_id","skill_chain_result_refs"],
  "properties":{
    "schema":{"const":"result-bundle/v1"},"contract_id":{"const":"artifact-bundle/v1"},"bundle_id":{"$ref":"#/$defs/id"},"bundle_type":{"const":"artifact"},"producer":{"$ref":"#/$defs/producer"},"input_snapshot_hash":{"$ref":"#/$defs/hash"},"items":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/artifact"}},"warnings":{"type":"array"},"partial":{"const":false},"provenance_receipt_id":{"$ref":"#/$defs/id"},"skill_chain_result_refs":{"type":"array","items":{"type":"object","additionalProperties":false}}
  },
  "$defs":{
    "id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},"hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "producer":{"type":"object","additionalProperties":false,"required":["plugin_id","release_id","capability_id","job_id","step_id","attempt_id","lease_epoch"],"properties":{"plugin_id":{"$ref":"#/$defs/id"},"release_id":{"$ref":"#/$defs/hash"},"capability_id":{"$ref":"#/$defs/id"},"job_id":{"$ref":"#/$defs/id"},"step_id":{"$ref":"#/$defs/id"},"attempt_id":{"$ref":"#/$defs/id"},"lease_epoch":{"type":"integer","minimum":1}}},
    "artifact":{"type":"object","additionalProperties":false,"required":["schema","item_id","artifact_kind","payload_asset_id","payload_hash","mime","source_refs","status"],"properties":{"schema":{"const":"artifact-item/v1"},"item_id":{"$ref":"#/$defs/id"},"artifact_kind":{"$ref":"#/$defs/id"},"payload_asset_id":{"$ref":"#/$defs/id"},"payload_hash":{"$ref":"#/$defs/hash"},"mime":{"type":"string","minLength":1},"source_refs":{"type":"array"},"status":{"const":"complete"}}}
  }
}