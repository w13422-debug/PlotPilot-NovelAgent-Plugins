{
  "$id": "source.evidence.search-request/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "capability_id", "operation_key", "operation",
    "job_id", "step_id", "attempt_id", "worker_run_id", "lease_epoch",
    "checkpoint_ids", "provenance_receipt_id", "created_at", "total_units",
    "run_snapshot_hash", "workspace_id", "document_id", "revision_id",
    "canonical_asset_id", "canonical_text_hash", "nodes", "query",
    "case_sensitive", "max_matches"
  ],
  "properties": {
    "schema": {"const": "source.evidence.search-request/v1"},
    "capability_id": {"const": "source.evidence.search/v1"},
    "operation_key": {"const": "source.evidence.search/v1"},
    "operation": {"const": "run"},
    "job_id": {"$ref": "#/$defs/id"},
    "step_id": {"$ref": "#/$defs/id"},
    "attempt_id": {"$ref": "#/$defs/id"},
    "worker_run_id": {"$ref": "#/$defs/id"},
    "lease_epoch": {"type": "integer", "minimum": 1},
    "checkpoint_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "provenance_receipt_id": {"$ref": "#/$defs/id"},
    "created_at": {"$ref": "#/$defs/time"},
    "total_units": {"type": "integer", "minimum": 1},
    "run_snapshot_hash": {"$ref": "#/$defs/hash"},
    "workspace_id": {"$ref": "#/$defs/id"},
    "document_id": {"$ref": "#/$defs/id"},
    "revision_id": {"$ref": "#/$defs/id"},
    "canonical_asset_id": {"$ref": "#/$defs/id"},
    "canonical_text_hash": {"$ref": "#/$defs/hash"},
    "nodes": {"type": "array", "items": {"$ref": "../node.schema.json"}},
    "query": {"type": "string", "minLength": 1},
    "case_sensitive": {"type": "boolean"},
    "max_matches": {"type": "integer", "minimum": 1}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "time": {"type": "string", "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z|[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.(?!000)[0-9]{3}Z)$"}
  }
}
