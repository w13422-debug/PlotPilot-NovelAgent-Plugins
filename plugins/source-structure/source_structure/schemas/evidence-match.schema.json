{
  "$id":"source-evidence-match/v1",
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object","additionalProperties":false,
  "required":["schema","match_id","ordinal","span"],
  "properties":{
    "schema":{"const":"source-evidence-match/v1"},
    "match_id":{"$ref":"#/$defs/id"},
    "ordinal":{"type":"integer","minimum":0},
    "span":{"$ref":"evidence-span.schema.json"}
  },
  "$defs":{"id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"}}
}