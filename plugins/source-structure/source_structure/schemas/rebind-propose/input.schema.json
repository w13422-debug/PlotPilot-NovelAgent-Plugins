{
  "$id": "source.evidence.rebind.propose-request/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "capability_id", "operation_key", "operation",
    "job_id", "step_id", "attempt_id", "worker_run_id", "lease_epoch",
    "checkpoint_ids", "provenance_receipt_id", "created_at", "total_units",
    "run_snapshot_hash", "workspace_id", "document_id",
    "source_revision_id", "source_canonical_asset_id", "source_canonical_text_hash",
    "target_revision_id", "target_canonical_asset_id", "target_canonical_text_hash",
    "source_nodes", "target_nodes", "evidence_items",
    "selected_evidence_ids", "known_parent_candidate_ids"
  ],
  "properties": {
    "schema": {"const": "source.evidence.rebind.propose-request/v1"},
    "capability_id": {"const": "source.evidence.rebind.propose/v1"},
    "operation_key": {"const": "source.evidence.rebind.propose/v1"},
    "operation": {"enum": ["run", "validate"]},
    "job_id": {"$ref": "#/$defs/id"},
    "step_id": {"$ref": "#/$defs/id"},
    "attempt_id": {"$ref": "#/$defs/id"},
    "worker_run_id": {"$ref": "#/$defs/id"},
    "lease_epoch": {"type": "integer", "minimum": 1},
    "checkpoint_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "provenance_receipt_id": {"$ref": "#/$defs/id"},
    "created_at": {"$ref": "#/$defs/time"},
    "total_units": {"type": "integer", "minimum": 1},
    "run_snapshot_hash": {"$ref": "#/$defs/hash"},
    "workspace_id": {"$ref": "#/$defs/id"},
    "document_id": {"$ref": "#/$defs/id"},
    "source_revision_id": {"$ref": "#/$defs/id"},
    "source_canonical_asset_id": {"$ref": "#/$defs/id"},
    "source_canonical_text_hash": {"$ref": "#/$defs/hash"},
    "target_revision_id": {"$ref": "#/$defs/id"},
    "target_canonical_asset_id": {"$ref": "#/$defs/id"},
    "target_canonical_text_hash": {"$ref": "#/$defs/hash"},
    "source_nodes": {"type": "array", "items": {"$ref": "../node.schema.json"}},
    "target_nodes": {"type": "array", "items": {"$ref": "../node.schema.json"}},
    "evidence_items": {"type": "array", "items": {"$ref": "../evidence-item.schema.json"}},
    "selected_evidence_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "known_parent_candidate_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "time": {"type": "string", "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z|[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.(?!000)[0-9]{3}Z)$"}
  }
}
