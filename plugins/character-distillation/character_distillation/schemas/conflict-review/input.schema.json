{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "analysis.character.conflict.review/v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "analysis.character.conflict.review-request/v1"
    },
    "capability_id": {
      "const": "analysis.character.conflict.review/v1"
    },
    "operation_key": {
      "const": "analysis.character.conflict.review/v1"
    },
    "operation": {
      "enum": [
        "run",
        "resume",
        "cancel",
        "validate"
      ]
    },
    "job_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "step_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "worker_run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "lease_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "checkpoint_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
      },
      "uniqueItems": true
    },
    "provenance_receipt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "created_at": {
      "type": "string",
      "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z|[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.(?!000)[0-9]{3}Z)$"
    },
    "total_units": {
      "type": "integer",
      "minimum": 1
    },
    "run_snapshot_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "document_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "source_revision_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "canonical_asset_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "canonical_text_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nodes": {
      "type": "array",
      "minItems": 1
    },
    "archetype_asset_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "archetype_asset_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "model_profile_revision_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "conflict_asset_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "conflict_asset_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema",
    "capability_id",
    "operation_key",
    "operation",
    "job_id",
    "step_id",
    "attempt_id",
    "worker_run_id",
    "lease_epoch",
    "checkpoint_ids",
    "provenance_receipt_id",
    "created_at",
    "total_units",
    "run_snapshot_hash",
    "workspace_id",
    "document_id",
    "source_revision_id",
    "canonical_asset_id",
    "canonical_text_hash",
    "nodes",
    "archetype_asset_id",
    "archetype_asset_hash",
    "model_profile_revision_id",
    "conflict_asset_id",
    "conflict_asset_hash"
  ]
}
