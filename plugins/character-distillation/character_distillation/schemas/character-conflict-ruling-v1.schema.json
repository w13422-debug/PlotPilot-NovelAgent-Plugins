{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Character Conflict Ruling",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "character-conflict-ruling/v1"
    },
    "conflict_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "selected_source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
      },
      "uniqueItems": true
    },
    "decision": {
      "enum": [
        "select",
        "reject",
        "defer"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "actor_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "created_at": {
      "type": "string",
      "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z|[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.(?!000)[0-9]{3}Z)$"
    }
  },
  "required": [
    "schema",
    "conflict_id",
    "selected_source_ids",
    "decision",
    "rationale",
    "actor_id",
    "created_at"
  ]
}
