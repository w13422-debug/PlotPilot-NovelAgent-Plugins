{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Character Atom",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "character-atom/v1"
    },
    "atom_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "character_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "dimension": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "kind": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "observation": {
      "type": "string",
      "minLength": 1
    },
    "interpretation": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "enum": [
        "confirmed",
        "inferred",
        "uncertain",
        "conflict"
      ]
    },
    "source_revision_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "evidence_spans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "EvidenceSpan",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema": {
            "const": "evidence-span/v1"
          },
          "workspace_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
          },
          "document_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
          },
          "revision_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
          },
          "node_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
          },
          "start_codepoint": {
            "type": "integer",
            "minimum": 0
          },
          "end_codepoint": {
            "type": "integer",
            "minimum": 0
          },
          "quote": {
            "type": "string"
          },
          "quote_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "canonical_text_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "schema",
          "workspace_id",
          "document_id",
          "revision_id",
          "node_id",
          "start_codepoint",
          "end_codepoint",
          "quote",
          "quote_hash",
          "canonical_text_hash"
        ]
      },
      "uniqueItems": true
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plugin_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "capability_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "package_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "release_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "run_snapshot_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "model_receipt_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "plugin_id",
        "capability_id",
        "package_hash",
        "release_id",
        "run_snapshot_hash",
        "model_receipt_id"
      ]
    },
    "authority": {
      "const": "candidate_only"
    }
  },
  "required": [
    "schema",
    "atom_id",
    "character_id",
    "dimension",
    "kind",
    "observation",
    "interpretation",
    "confidence",
    "source_revision_id",
    "evidence_spans",
    "provenance",
    "authority"
  ]
}
