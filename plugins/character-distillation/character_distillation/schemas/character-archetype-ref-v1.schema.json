{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Archetype ref",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "character-archetype-ref/v1"
    },
    "format_id": {
      "const": "character-archetype/v1"
    },
    "archetype_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "release_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "package_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "root_asset_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "root_asset_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema",
    "format_id",
    "archetype_id",
    "release_id",
    "package_hash",
    "root_asset_id",
    "root_asset_hash"
  ]
}
