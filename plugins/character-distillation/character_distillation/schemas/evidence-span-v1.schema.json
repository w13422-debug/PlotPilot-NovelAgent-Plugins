{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvidenceSpan",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "evidence-span/v1"
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "document_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "revision_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "node_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "start_codepoint": {
      "type": "integer",
      "minimum": 0
    },
    "end_codepoint": {
      "type": "integer",
      "minimum": 0
    },
    "quote": {
      "type": "string"
    },
    "quote_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "canonical_text_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema",
    "workspace_id",
    "document_id",
    "revision_id",
    "node_id",
    "start_codepoint",
    "end_codepoint",
    "quote",
    "quote_hash",
    "canonical_text_hash"
  ]
}
