{
  "$id": "source.import.parse-request/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlotPilot source import parse request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "source.import.parse-request/v1"},
    "capability_id": {"const": "source.import.parse/v1"},
    "worker_run_id": {"$ref": "#/$defs/id"},
    "job_id": {"$ref": "#/$defs/id"},
    "step_id": {"$ref": "#/$defs/id"},
    "attempt_id": {"$ref": "#/$defs/id"},
    "lease_epoch": {"type": "integer", "minimum": 1},
    "run_snapshot_hash": {"$ref": "#/$defs/hash"},
    "source_asset_id": {"$ref": "#/$defs/id"},
    "source_asset_hash": {"$ref": "#/$defs/hash"},
    "source_kind": {"enum": ["txt", "epub", "paste"]},
    "source_name": {
      "anyOf": [
        {
          "type": "string", "minLength": 1, "maxLength": 240,
          "not": {"anyOf": [{"enum": [".", ".."]}, {"pattern": "[\\\\/\\u0000]"}, {"pattern": "[ .]$"}]}
        },
        {"type": "null"}
      ]
    },
    "encoding": {"type": "string", "minLength": 1, "maxLength": 32},
    "page_size": {"type": "integer", "minimum": 1, "maximum": 1048576},
    "checkpoint_id": {"$ref": "#/$defs/id"},
    "checkpoint_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "resume_checkpoint_asset_id": {"$ref": "#/$defs/id"},
    "resume_checkpoint_asset_hash": {"$ref": "#/$defs/hash"},
    "resume_state_asset_id": {"$ref": "#/$defs/id"},
    "resume_state_asset_hash": {"$ref": "#/$defs/hash"},
    "provenance_receipt_id": {"$ref": "#/$defs/id"},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "target": {"$ref": "#/$defs/target"},
    "base": {"$ref": "#/$defs/base"},
    "structure_target": {"$ref": "#/$defs/structure_target"},
    "structure_base": {"$ref": "#/$defs/base"}
  },
  "required": [
    "schema", "worker_run_id", "job_id", "step_id", "attempt_id",
    "lease_epoch", "run_snapshot_hash", "source_asset_id", "source_asset_hash",
    "source_kind", "provenance_receipt_id", "target", "base"
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z|[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.(?!000)[0-9]{3}Z)$"},
    "target": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "workspace_id": {"$ref": "#/$defs/id"},
        "entity_kind": {"enum": ["document", "node_structure"]},
        "entity_id": {"$ref": "#/$defs/id"}
      },
      "required": ["workspace_id", "entity_kind", "entity_id"]
    },
    "structure_target": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "workspace_id": {"$ref": "#/$defs/id"},
        "entity_kind": {"const": "node_structure"},
        "entity_id": {"$ref": "#/$defs/id"}
      },
      "required": ["workspace_id", "entity_kind", "entity_id"]
    },
    "base": {
      "type": "object", "additionalProperties": false,
      "properties": {"revision_id": {"$ref": "#/$defs/id"}, "content_hash": {"$ref": "#/$defs/hash"}},
      "required": ["revision_id", "content_hash"]
    }
  }
}
