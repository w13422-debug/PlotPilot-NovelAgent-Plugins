{
  "$id": "source.import.parse-result/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlotPilot source import parse result",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "source.import.parse-result/v1"},
    "status": {"enum": ["succeeded", "failed", "cancelled"]},
    "result": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/bundle"}]},
    "conditional_result": {"type": "null"},
    "receipt": {"$ref": "#/$defs/receipt"},
    "error": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/error"}]},
    "checkpoint": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/checkpoint_wrapper"}]},
    "read": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/read"}]}
  },
  "required": ["schema", "status", "result", "conditional_result", "receipt", "error", "checkpoint", "read"],
  "oneOf": [
    {
      "properties": {
        "status": {"const": "succeeded"}, "result": {"$ref": "#/$defs/bundle"},
        "error": {"type": "null"}, "checkpoint": {"type": "null"},
        "read": {"$ref": "#/$defs/read_success"}
      }
    },
    {
      "properties": {
        "status": {"const": "failed"}, "result": {"type": "null"},
        "error": {"$ref": "#/$defs/error"}, "checkpoint": {"type": "null"},
        "read": {"type": "null"}
      }
    },
    {
      "properties": {
        "status": {"const": "cancelled"}, "result": {"type": "null"},
        "error": {"$ref": "#/$defs/cancel_error"},
        "checkpoint": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/checkpoint_wrapper"}]},
        "read": {"$ref": "#/$defs/read_cancelled"}
      }
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z|[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.(?!000)[0-9]{3}Z)$"},
    "source_ref": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "workspace_id": {"type": "null"},
        "source_type": {"const": "asset"},
        "source_id": {"$ref": "#/$defs/id"},
        "revision_or_hash": {"$ref": "#/$defs/hash"}
      },
      "required": ["workspace_id", "source_type", "source_id", "revision_or_hash"]
    },
    "producer": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "plugin_id": {"const": "com.plotpilot.novelagent.source-import"},
        "release_id": {"$ref": "#/$defs/hash"},
        "capability_id": {"const": "source.import.parse/v1"},
        "job_id": {"$ref": "#/$defs/id"}, "step_id": {"$ref": "#/$defs/id"},
        "attempt_id": {"$ref": "#/$defs/id"}, "lease_epoch": {"type": "integer", "minimum": 1}
      },
      "required": ["plugin_id", "release_id", "capability_id", "job_id", "step_id", "attempt_id", "lease_epoch"]
    },
    "receipt": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "schema": {"const": "provenance-receipt/v1"}, "receipt_id": {"$ref": "#/$defs/id"},
        "plugin_id": {"const": "com.plotpilot.novelagent.source-import"}, "release_id": {"$ref": "#/$defs/hash"},
        "package_hash": {"$ref": "#/$defs/hash"}, "capability_id": {"$ref": "#/$defs/id"},
        "job_id": {"$ref": "#/$defs/id"}, "step_id": {"$ref": "#/$defs/id"}, "attempt_id": {"$ref": "#/$defs/id"},
        "lease_epoch": {"type": "integer", "minimum": 1}, "run_snapshot_hash": {"$ref": "#/$defs/hash"},
        "bundle_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "bundle_hash": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "parent_receipt_ids": {"type": "array", "maxItems": 0},
        "model_receipt_ids": {"type": "array", "maxItems": 0},
        "skill_chain_result_refs": {"type": "array", "maxItems": 0},
        "staged_items": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "created_at": {"$ref": "#/$defs/timestamp"}, "receipt_hash": {"$ref": "#/$defs/hash"}
      },
      "required": ["schema", "receipt_id", "plugin_id", "release_id", "package_hash", "capability_id", "job_id", "step_id", "attempt_id", "lease_epoch", "run_snapshot_hash", "bundle_id", "bundle_hash", "parent_receipt_ids", "model_receipt_ids", "skill_chain_result_refs", "staged_items", "created_at", "receipt_hash"]
    },
    "checkpoint": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "schema": {"const": "checkpoint/v1"}, "checkpoint_id": {"$ref": "#/$defs/id"},
        "checkpoint_seq": {"type": "integer", "minimum": 1}, "job_id": {"$ref": "#/$defs/id"},
        "step_id": {"$ref": "#/$defs/id"}, "source_attempt_id": {"$ref": "#/$defs/id"},
        "lease_epoch": {"type": "integer", "minimum": 1}, "run_snapshot_hash": {"$ref": "#/$defs/hash"},
        "replay_policy": {"enum": ["idempotent_auto", "checkpoint_resume", "manual_if_unknown", "never_replay"]},
        "completed_units": {"type": "integer", "minimum": 0}, "total_units": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "unit_set_hash": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "state_asset_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "created_at": {"$ref": "#/$defs/timestamp"}, "checkpoint_hash": {"$ref": "#/$defs/hash"}
      },
      "required": ["schema", "checkpoint_id", "checkpoint_seq", "job_id", "step_id", "source_attempt_id", "lease_epoch", "run_snapshot_hash", "replay_policy", "completed_units", "total_units", "unit_set_hash", "state_asset_id", "created_at", "checkpoint_hash"]
    },
    "checkpoint_wrapper": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "checkpoint": {"$ref": "#/$defs/checkpoint"},
        "checkpoint_asset_id": {"$ref": "#/$defs/id"},
        "checkpoint_asset_hash": {"$ref": "#/$defs/hash"},
        "state_asset_id": {"$ref": "#/$defs/id"},
        "state_asset_hash": {"$ref": "#/$defs/hash"}
      },
      "required": ["checkpoint", "checkpoint_asset_id", "checkpoint_asset_hash", "state_asset_id", "state_asset_hash"]
    },
    "error": {
      "type": "object", "additionalProperties": false,
      "properties": {"code": {"type": "string", "minLength": 1}, "message": {"type": "string"}, "retryable": {"type": "boolean"}},
      "required": ["code", "message", "retryable"]
    },
    "cancel_error": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "code": {"const": "CANCELLED"}, "message": {"type": "string", "minLength": 1},
        "retryable": {"const": false}
      },
      "required": ["code", "message", "retryable"]
    },
    "read": {
      "type": "object", "additionalProperties": false,
      "properties": {"page_count": {"type": "integer", "minimum": 0}, "page_hashes": {"type": "array", "items": {"$ref": "#/$defs/hash"}}, "next_offset": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]}},
      "required": ["page_count", "page_hashes", "next_offset"]
    },
    "read_success": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "page_count": {"type": "integer", "minimum": 1},
        "page_hashes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/hash"}},
        "next_offset": {"type": "null"}
      },
      "required": ["page_count", "page_hashes", "next_offset"]
    },
    "read_cancelled": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "page_count": {"type": "integer", "minimum": 0},
        "page_hashes": {"type": "array", "maxItems": 0},
        "next_offset": {"type": "integer", "minimum": 0}
      },
      "required": ["page_count", "page_hashes", "next_offset"]
    }
,
    "target": {
      "type": "object", "additionalProperties": false,
      "properties": {"workspace_id": {"$ref": "#/$defs/id"}, "entity_kind": {"enum": ["document", "node_structure"]}, "entity_id": {"$ref": "#/$defs/id"}},
      "required": ["workspace_id", "entity_kind", "entity_id"]
    },
    "base": {
      "type": "object", "additionalProperties": false,
      "properties": {"revision_id": {"$ref": "#/$defs/id"}, "content_hash": {"$ref": "#/$defs/hash"}},
      "required": ["revision_id", "content_hash"]
    },
    "mutation": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["replace", "structure_patch"]},
        "payload_schema": {"enum": ["core/document-text/v1", "core/node-structure/v1"]},
        "payload_hash": {"$ref": "#/$defs/hash"}
      },
      "required": ["mode", "payload_schema", "payload_hash"]
    },
    "write_set_item": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "workspace_id": {"$ref": "#/$defs/id"},
        "entity_kind": {"enum": ["document", "node_structure"]},
        "entity_id": {"$ref": "#/$defs/id"},
        "revision_id": {"$ref": "#/$defs/id"},
        "content_hash": {"$ref": "#/$defs/hash"}
      },
      "required": ["workspace_id", "entity_kind", "entity_id", "revision_id", "content_hash"]
    },
    "candidate_item": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "schema": {"const": "candidate-item/v1"}, "item_id": {"$ref": "#/$defs/id"},
        "item_kind": {"enum": ["document", "node_structure"]}, "target": {"$ref": "#/$defs/target"},
        "mutation": {"$ref": "#/$defs/mutation"},
        "payload_asset_id": {"$ref": "#/$defs/id"}, "base": {"$ref": "#/$defs/base"},
        "write_set": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/write_set_item"}},
        "parent_candidate_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "source_refs": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/source_ref"}},
        "status": {"const": "complete"}
      },
      "required": ["schema", "item_id", "item_kind", "target", "mutation", "payload_asset_id", "base", "write_set", "parent_candidate_ids", "source_refs", "status"]
    },
    "bundle": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "schema": {"const": "result-bundle/v1"}, "contract_id": {"const": "candidate-batch/v1"},
        "bundle_id": {"$ref": "#/$defs/id"}, "bundle_type": {"const": "candidate_batch"},
        "producer": {"$ref": "#/$defs/producer"}, "input_snapshot_hash": {"$ref": "#/$defs/hash"},
        "items": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"$ref": "#/$defs/candidate_item"}},
        "warnings": {"type": "array", "maxItems": 0},
        "partial": {"const": false}, "provenance_receipt_id": {"$ref": "#/$defs/id"},
        "skill_chain_result_refs": {"type": "array", "maxItems": 0}
      },
      "required": ["schema", "contract_id", "bundle_id", "bundle_type", "producer", "input_snapshot_hash", "items", "warnings", "partial", "provenance_receipt_id", "skill_chain_result_refs"]
    }
  }
}
