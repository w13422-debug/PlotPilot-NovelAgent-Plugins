{
  "schema": "plotpilot-plugin/v1",
  "plugin_id": "com.plotpilot.novelagent.source-import",
  "version": "0.1.0",
  "display_name": "Novel-Agent Source Import",
  "compatibility": {
    "core_api": ">=1.0 <2.0",
    "plugin_rpc": "1",
    "ui_host": "1",
    "python": "3.12.*"
  },
  "capabilities": [
    {
      "capability_id": "source.import.inspect/v1",
      "operations": ["run", "cancel"],
      "result_contract": "artifact-bundle/v1"
    },
    {
      "capability_id": "source.import.parse/v1",
      "operations": ["run", "resume", "cancel"],
      "result_contract": "candidate-batch/v1"
    }
  ],
  "settings": null,
  "needs": [
    "host.asset.read/v1",
    "host.asset.create/v1",
    "host.asset.upload.status/v1",
    "host.job.event/v1",
    "host.job.complete/v1",
    "host.checkpoint.commit/v1",
    "host.candidate.stage/v1"
  ],
  "kind": "code",
  "backend": {
    "entrypoint": "source_import.worker:main",
    "wheel": "backend/plotpilot_source_import-0.1.0-py3-none-any.whl",
    "requirements_lock": "backend/requirements.lock",
    "wheelhouse": "backend/wheels",
    "max_concurrency": 1
  },
  "storage": {
    "schema_version": 1,
    "migration_policy": "transactional-shadow",
    "migration_manifest": "migrations/manifest.json"
  },
  "ui": null,
  "data": null
}
