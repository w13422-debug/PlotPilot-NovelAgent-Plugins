{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "outline.projection.render-result/v1",
  "title": "outline.projection.render-result/v1",
  "oneOf": [
    {
      "$ref": "#/$defs/artifact_bundle"
    },
    {
      "$ref": "#/$defs/diagnostic_bundle"
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_id",
        "source_type",
        "source_id",
        "revision_or_hash"
      ],
      "properties": {
        "workspace_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_type": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "revision_or_hash": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "item_id",
        "artifact_kind",
        "payload_asset_id",
        "payload_hash",
        "mime",
        "source_refs",
        "status"
      ],
      "properties": {
        "schema": {
          "const": "artifact-item/v1"
        },
        "item_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "artifact_kind": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "payload_asset_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "payload_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "mime": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "workspace_id",
              "source_type",
              "source_id",
              "revision_or_hash"
            ],
            "properties": {
              "workspace_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "source_type": {
                "type": "string",
                "minLength": 1
              },
              "source_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
              },
              "revision_or_hash": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "minItems": 1
        },
        "status": {
          "enum": [
            "complete",
            "partial",
            "failed",
            "skipped"
          ]
        }
      }
    },
    "diag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "item_id",
        "severity",
        "code",
        "message",
        "details_asset_id",
        "details_hash",
        "source_refs",
        "status"
      ],
      "properties": {
        "schema": {
          "const": "diagnostic-item/v1"
        },
        "item_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "details_asset_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "details_hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "workspace_id",
              "source_type",
              "source_id",
              "revision_or_hash"
            ],
            "properties": {
              "workspace_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "source_type": {
                "type": "string",
                "minLength": 1
              },
              "source_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
              },
              "revision_or_hash": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "status": {
          "enum": [
            "complete",
            "failed",
            "skipped"
          ]
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plugin_id",
        "release_id",
        "capability_id",
        "job_id",
        "step_id",
        "attempt_id",
        "lease_epoch"
      ],
      "properties": {
        "plugin_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "release_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "capability_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "job_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "step_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "lease_epoch": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "chain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "chain_result_id",
        "asset_id",
        "asset_hash",
        "result_bundle_id",
        "result_item_id",
        "stream_id",
        "acked_prefix_hash"
      ],
      "properties": {
        "schema": {
          "const": "skill-chain-ref/v1"
        },
        "chain_result_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "asset_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "asset_hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "result_bundle_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "result_item_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "stream_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "acked_prefix_hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "asset_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
                },
                "asset_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            {
              "properties": {
                "asset_id": {
                  "type": "null"
                },
                "asset_hash": {
                  "type": "null"
                }
              }
            }
          ]
        },
        {
          "oneOf": [
            {
              "properties": {
                "result_bundle_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
                },
                "result_item_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
                },
                "stream_id": {
                  "type": "null"
                },
                "acked_prefix_hash": {
                  "type": "null"
                }
              }
            },
            {
              "properties": {
                "result_bundle_id": {
                  "type": "null"
                },
                "result_item_id": {
                  "type": "null"
                },
                "stream_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
                },
                "acked_prefix_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          ]
        }
      ]
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "details_asset_id"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "details_asset_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "base_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "contract_id",
        "bundle_id",
        "bundle_type",
        "producer",
        "input_snapshot_hash",
        "items",
        "warnings",
        "partial",
        "provenance_receipt_id",
        "skill_chain_result_refs"
      ],
      "properties": {
        "schema": {
          "const": "result-bundle/v1"
        },
        "contract_id": {
          "enum": [
            "artifact-bundle/v1",
            "diagnostic-bundle/v1"
          ]
        },
        "bundle_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "bundle_type": {
          "enum": [
            "artifact",
            "diagnostic"
          ]
        },
        "producer": {
          "$ref": "#/$defs/producer"
        },
        "input_snapshot_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "items": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/artifact"
              },
              {
                "$ref": "#/$defs/diag"
              }
            ]
          },
          "minItems": 0
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/warning"
          },
          "minItems": 0
        },
        "partial": {
          "type": "boolean"
        },
        "provenance_receipt_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "skill_chain_result_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/chain"
          },
          "minItems": 0
        }
      }
    },
    "artifact_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "contract_id",
        "bundle_id",
        "bundle_type",
        "producer",
        "input_snapshot_hash",
        "items",
        "warnings",
        "partial",
        "provenance_receipt_id",
        "skill_chain_result_refs"
      ],
      "properties": {
        "schema": {
          "const": "result-bundle/v1"
        },
        "contract_id": {
          "const": "artifact-bundle/v1"
        },
        "bundle_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "bundle_type": {
          "const": "artifact"
        },
        "producer": {
          "$ref": "#/$defs/producer"
        },
        "input_snapshot_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          },
          "minItems": 1
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/warning"
          },
          "minItems": 0
        },
        "partial": {
          "const": false
        },
        "provenance_receipt_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "skill_chain_result_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/chain"
          },
          "minItems": 0
        }
      }
    },
    "diagnostic_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "contract_id",
        "bundle_id",
        "bundle_type",
        "producer",
        "input_snapshot_hash",
        "items",
        "warnings",
        "partial",
        "provenance_receipt_id",
        "skill_chain_result_refs"
      ],
      "properties": {
        "schema": {
          "const": "result-bundle/v1"
        },
        "contract_id": {
          "const": "diagnostic-bundle/v1"
        },
        "bundle_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "bundle_type": {
          "const": "diagnostic"
        },
        "producer": {
          "$ref": "#/$defs/producer"
        },
        "input_snapshot_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diag"
          },
          "minItems": 1
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/warning"
          },
          "minItems": 0
        },
        "partial": {
          "const": true
        },
        "provenance_receipt_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "skill_chain_result_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/chain"
          },
          "minItems": 0
        }
      }
    }
  }
}
