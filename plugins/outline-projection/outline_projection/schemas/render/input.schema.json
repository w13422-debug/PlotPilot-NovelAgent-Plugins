{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "capability_id",
    "operation_key",
    "operation",
    "job_id",
    "step_id",
    "attempt_id",
    "worker_run_id",
    "lease_epoch",
    "checkpoint_ids",
    "provenance_receipt_id",
    "created_at",
    "total_units",
    "run_snapshot_hash",
    "workspace_id",
    "source_bundle_asset_id",
    "source_bundle_hash",
    "narrative_unit_assets",
    "views"
  ],
  "properties": {
    "schema": {
      "const": "outline.projection.render-request/v1"
    },
    "capability_id": {
      "const": "outline.projection.render/v1"
    },
    "operation_key": {
      "const": "outline.projection.render/v1"
    },
    "operation": {
      "enum": [
        "run",
        "cancel"
      ]
    },
    "job_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "step_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "worker_run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "lease_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "checkpoint_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "provenance_receipt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "created_at": {
      "type": "string",
      "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z|[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\\\.(?!000)[0-9]{3}Z)$"
    },
    "total_units": {
      "type": "integer",
      "minimum": 1
    },
    "run_snapshot_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "views": {
      "type": "array",
      "items": {
        "enum": [
          "tree",
          "card",
          "timeline",
          "relation"
        ]
      },
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true
    },
    "source_receipt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "source_receipt_asset_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "source_receipt_asset_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_canonical_asset_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "source_canonical_asset_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_bundle_asset_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "source_bundle_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "narrative_unit_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id",
          "asset_hash"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
          },
          "asset_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "minItems": 1
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "outline.projection.render-request/v1",
  "title": "outline.projection.render-request/v1",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "run"
          }
        }
      },
      "then": {
        "required": [
          "source_receipt_id",
          "source_receipt_asset_id",
          "source_receipt_asset_hash"
        ]
      }
    }
  ]
}
