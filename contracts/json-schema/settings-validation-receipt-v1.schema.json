{
  "$id": "https://plotpilot.local/contracts/settings-validation-receipt-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z|[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.(?!000)[0-9]{3}Z)$",
      "type": "string"
    },
    "details_asset_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "payload_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "plugin_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
      "type": "string"
    },
    "plugin_release_id": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "receipt_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "receipt_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
      "type": "string"
    },
    "schema": {
      "const": "settings-validation-receipt/v1"
    },
    "schema_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "settings_revision_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
      "type": "string"
    },
    "valid": {
      "type": "boolean"
    }
  },
  "required": [
    "schema",
    "receipt_id",
    "plugin_id",
    "plugin_release_id",
    "settings_revision_id",
    "schema_hash",
    "payload_hash",
    "valid",
    "details_asset_id",
    "created_at",
    "receipt_hash"
  ],
  "title": "PlotPilot settings-validation-receipt-v1",
  "type": "object"
}
