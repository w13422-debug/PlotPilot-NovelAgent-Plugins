                        "node_structure",
                        "relation_set"
                      ]
                    },
                    "revision_id": {
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
                      "type": "string"
                    },
                    "workspace_id": {
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "workspace_id",
                    "entity_kind",
                    "entity_id",
                    "revision_id",
                    "content_hash"
                  ],
                  "type": "object"
                },
                "minItems": 1,
                "type": "array"
              }
