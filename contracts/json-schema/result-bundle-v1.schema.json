                  "payload_hash": {
                    "pattern": "^[0-9a-f]{64}$",
                    "type": "string"
                  },
                  "payload_schema": {
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
                    "type": "string"
