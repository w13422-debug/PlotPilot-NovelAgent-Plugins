        "artifact",
        "diagnostic"
      ]
    },
    "contract_id": {
      "enum": [
        "candidate-batch/v1",
        "artifact-bundle/v1",
        "diagnostic-bundle/v1"
      ]
    },
    "input_snapshot_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
