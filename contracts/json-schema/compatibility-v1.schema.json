{
  "$id": "https://plotpilot.local/contracts/compatibility-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "core_api": {
      "pattern": "^>=(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*) <(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "plugin_rpc": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "python": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.\\*$",
      "type": "string"
    },
    "ui_host": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    }
  },
  "required": [
    "core_api",
    "plugin_rpc",
    "ui_host"
  ],
  "title": "PlotPilot compatibility/v1",
  "type": "object"
}
