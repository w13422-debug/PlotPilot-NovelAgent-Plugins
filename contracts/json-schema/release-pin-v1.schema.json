{
  "$id": "https://plotpilot.local/contracts/release-pin-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z|[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.(?!000)[0-9]{3}Z)$",
      "type": "string"
    },
    "owner_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
      "type": "string"
    },
    "pin_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
      "type": "string"
    },
    "pin_kind": {
      "enum": [
        "current_generation",
        "lkg_generation",
        "pending_generation",
        "plan_binding",
        "job",
        "attempt",
        "worker",
        "install",
        "backup"
      ]
    },
    "release_id": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "released_at": {
      "anyOf": [
        {
          "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z|[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.(?!000)[0-9]{3}Z)$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "retire_epoch": {
      "minimum": 1,
      "type": "integer"
    },
    "schema": {
      "const": "release-pin/v1"
    }
  },
  "required": [
    "schema",
    "pin_id",
    "release_id",
    "retire_epoch",
    "pin_kind",
    "owner_id",
    "created_at",
    "released_at"
  ],
  "title": "PlotPilot release-pin-v1",
  "type": "object"
}
