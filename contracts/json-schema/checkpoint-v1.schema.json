{
  "$id": "https://plotpilot.local/contracts/checkpoint-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "checkpoint_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "checkpoint_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
      "type": "string"
    },
    "checkpoint_seq": {
      "minimum": 1,
      "type": "integer"
    },
    "completed_units": {
      "minimum": 0,
      "type": "integer"
    },
    "created_at": {
      "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z|[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.(?!000)[0-9]{3}Z)$",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
      "type": "string"
    },
    "lease_epoch": {
      "minimum": 1,
      "type": "integer"
    },
    "replay_policy": {
      "enum": [
        "idempotent_auto",
        "checkpoint_resume",
        "manual_if_unknown",
        "never_replay"
      ]
    },
    "run_snapshot_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema": {
      "const": "checkpoint/v1"
    },
    "source_attempt_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
      "type": "string"
    },
    "state_asset_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "step_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
      "type": "string"
    },
    "total_units": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "unit_set_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema",
    "checkpoint_id",
    "checkpoint_seq",
    "job_id",
    "step_id",
    "source_attempt_id",
    "lease_epoch",
    "run_snapshot_hash",
    "replay_policy",
    "completed_units",
    "total_units",
    "unit_set_hash",
    "state_asset_id",
    "created_at",
    "checkpoint_hash"
  ],
  "title": "PlotPilot checkpoint-v1",
  "type": "object"
}
