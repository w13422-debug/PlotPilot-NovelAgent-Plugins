{
  "$id": "https://plotpilot.local/contracts/artifact-item-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_kind": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
      "type": "string"
    },
    "item_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
      "type": "string"
    },
    "mime": {
      "minLength": 1,
      "type": "string"
    },
    "payload_asset_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
      "type": "string"
    },
    "payload_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema": {
      "const": "artifact-item/v1"
    },
    "source_refs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "revision_or_hash": {
            "minLength": 1,
            "type": "string"
          },
          "source_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
            "type": "string"
          },
          "source_type": {
            "minLength": 1,
            "type": "string"
          },
          "workspace_id": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "workspace_id",
          "source_type",
          "source_id",
          "revision_or_hash"
        ],
        "type": "object"
      },
      "minItems": 0,
      "type": "array"
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "failed",
        "skipped"
      ]
    }
  },
  "required": [
    "schema",
    "item_id",
    "artifact_kind",
    "payload_asset_id",
    "payload_hash",
    "mime",
    "source_refs",
    "status"
  ],
  "title": "PlotPilot artifact-item-v1",
  "type": "object"
}
