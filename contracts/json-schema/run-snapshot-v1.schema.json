{
  "$id": "https://plotpilot.local/contracts/run-snapshot-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "asset_hashes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "asset_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "asset_id",
          "sha256"
        ],
        "type": "object"
      },
      "minItems": 0,
      "type": "array"
    },
    "core_contract_version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "type": "string"
    },
    "created_at": {
      "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z|[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.(?!000)[0-9]{3}Z)$",
      "type": "string"
    },
    "data_bindings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "bundle_asset_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
            "type": "string"
          },
          "bundle_hash": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "data_plugin_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
            "type": "string"
          },
          "data_release_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
            "type": "string"
          },
          "format_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
            "type": "string"
          },
          "interpreter_binding_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
            "type": "string"
          },
          "order": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "data_plugin_id",
          "data_release_id",
          "format_id",
          "bundle_asset_id",
          "bundle_hash",
          "interpreter_binding_id",
          "order"
        ],
        "type": "object"
      },
      "minItems": 0,
      "type": "array"
    },
    "input_revisions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "content_hash": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "document_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
            "type": "string"
          },
          "revision_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
            "type": "string"
          }
        },
        "required": [
          "document_id",
          "revision_id",
          "content_hash"
        ],
        "type": "object"
      },
      "minItems": 0,
      "type": "array"
    },
    "model_profile_revision_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "parameters_asset_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "plan_revision_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
      "type": "string"
    },
    "plugin_releases": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "data_generation_id": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "package_hash": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "plugin_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
            "type": "string"
          },
          "release_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
            "type": "string"
          }
        },
        "required": [
          "plugin_id",
          "release_id",
          "package_hash",
          "data_generation_id"
        ],
        "type": "object"
      },
      "minItems": 0,
      "type": "array"
    },
    "plugin_settings_revisions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "plugin_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
            "type": "string"
          },
          "schema_hash": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "scope": {
            "enum": [
              "global",
              "workspace"
            ]
          },
          "scope_id": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "settings_revision_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
            "type": "string"
          },
          "validated_by_release_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
            "type": "string"
          }
        },
        "required": [
          "plugin_id",
          "settings_revision_id",
          "scope",
          "scope_id",
          "schema_hash",
          "validated_by_release_id"
        ],
        "type": "object"
      },
      "minItems": 0,
      "type": "array"
    },
    "request_key": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "run_intent_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
      "type": "string"
    },
    "schema": {
      "const": "run-snapshot/v1"
    },
    "scope": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "node_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "operation": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "node_id",
        "operation"
      ],
      "type": "object"
    },
    "skill_releases": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "order": {
            "minimum": 1,
            "type": "integer"
          },
          "package_hash": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "parameters_asset_id": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "release_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
            "type": "string"
          },
          "skill_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
            "type": "string"
          }
        },
        "required": [
          "skill_id",
          "release_id",
          "package_hash",
          "parameters_asset_id",
          "order"
        ],
        "type": "object"
      },
      "minItems": 0,
      "type": "array"
    },
    "snapshot_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "snapshot_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
      "type": "string"
    },
    "workspace_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "snapshot_id",
    "core_contract_version",
    "workspace_id",
    "scope",
    "input_revisions",
    "plan_revision_id",
    "plugin_releases",
    "plugin_settings_revisions",
    "data_bindings",
    "skill_releases",
    "model_profile_revision_id",
    "parameters_asset_id",
    "asset_hashes",
    "request_key",
    "run_intent_id",
    "created_at",
    "snapshot_hash"
  ],
  "title": "PlotPilot run-snapshot-v1",
  "type": "object"
}
