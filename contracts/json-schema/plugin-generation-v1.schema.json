{
  "$id": "https://plotpilot.local/contracts/plugin-generation-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "base_generation_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "core_api_version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "type": "string"
    },
    "created_at": {
      "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z|[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.(?!000)[0-9]{3}Z)$",
      "type": "string"
    },
    "created_reason": {
      "minLength": 1,
      "type": "string"
    },
    "generation_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
      "type": "string"
    },
    "health_result_asset_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
      "type": "string"
    },
    "members": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "data_bundle_asset_id": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "data_generation_id": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "global_settings_revision_id": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "package_hash": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "plugin_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
            "type": "string"
          },
          "release_id": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "settings_schema_hash": {
            "anyOf": [
              {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "ui_bundle_hash": {
            "anyOf": [
              {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "plugin_id",
          "release_id",
          "package_hash",
          "data_generation_id",
          "ui_bundle_hash",
          "global_settings_revision_id",
          "settings_schema_hash",
          "data_bundle_asset_id"
        ],
        "type": "object"
      },
      "minItems": 0,
      "type": "array"
    },
    "parent_generation_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema": {
      "const": "plugin-generation/v1"
    }
  },
  "required": [
    "schema",
    "generation_id",
    "core_api_version",
    "members",
    "created_reason",
    "created_at",
    "health_result_asset_id",
    "parent_generation_id",
    "base_generation_id"
  ],
  "title": "PlotPilot plugin-generation-v1",
  "type": "object"
}
