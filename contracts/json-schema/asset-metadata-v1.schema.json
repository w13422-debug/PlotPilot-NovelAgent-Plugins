        "asset_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "type": "string"
        },
        "schema": {
          "const": "asset-query/v1"
        }
      },
      "required": [
        "schema",
        "asset_id"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "type": "string"
        },
        "length": {
          "maximum": 1048576,
          "minimum": 0,
          "type": "integer"
        },
        "offset": {
          "minimum": 0,
          "type": "integer"
        },
        "schema": {
          "const": "asset-read-range-query/v1"
        }
      },
      "required": [
        "schema",
        "asset_id",
        "offset",
        "length"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "type": "string"
        },
        "logical_role": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "type": "string"
        },
        "mime": {
          "pattern": "^[^\\s/]+/[^\\s/]+$",
          "type": "string"
        },
        "provenance": {
          "minLength": 1,
          "type": "string"
        },
        "rebuildable": {
          "type": "boolean"
        },
        "schema": {
          "const": "asset-metadata/v1"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "schema",
        "asset_id",
        "sha256",
        "mime",
        "size",
        "logical_role",
        "provenance",
        "rebuildable"
      ],
      "type": "object"
