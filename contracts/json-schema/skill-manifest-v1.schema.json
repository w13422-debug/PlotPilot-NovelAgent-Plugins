{
  "$id": "https://plotpilot.local/contracts/skill-manifest-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actions": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "display_name": {
      "minLength": 1,
      "type": "string"
    },
    "schema": {
      "const": "plotpilot-skill/v1"
    },
    "skill_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
      "type": "string"
    },
    "stage": {
      "minLength": 1,
      "type": "string"
    },
    "version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "skill_id",
    "version",
    "display_name",
    "stage",
    "actions"
  ],
  "title": "PlotPilot skill-manifest-v1",
  "type": "object"
}
