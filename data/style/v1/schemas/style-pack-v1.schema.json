{
  "$id": "https://plotpilot.local/data/style-pack-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "style_pack_id",
    "version",
    "style_release_id",
    "payload_hash",
    "source_cas",
    "target_cas",
    "manufacture_snapshot",
    "features",
    "lexicon_bindings",
    "constraints",
    "exemplar_hashes"
  ],
  "properties": {
    "schema": {
      "const": "style-pack/v1"
    },
    "style_pack_id": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "style_release_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "payload_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_cas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "sha256",
        "revision_id"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "revision_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        }
      }
    },
    "target_cas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_id",
        "entity_id",
        "base_revision_id",
        "base_content_hash"
      ],
      "properties": {
        "workspace_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "entity_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "base_revision_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "base_content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "manufacture_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_snapshot_hash",
        "route_id",
        "prompt_hash",
        "output_schema_hash",
        "chunk_plan_hash",
        "provider_attempt_ids",
        "checkpoint_ids",
        "usage"
      ],
      "properties": {
        "run_snapshot_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "route_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "prompt_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "output_schema_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "chunk_plan_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "provider_attempt_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
          }
        },
        "checkpoint_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
          }
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input_tokens",
            "output_tokens",
            "total_tokens"
          ],
          "properties": {
            "input_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "total_tokens": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "voice",
        "rhythm",
        "syntax",
        "imagery",
        "taboos"
      ],
      "properties": {
        "voice": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rhythm": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "syntax": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "imagery": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "taboos": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "lexicon_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data_plugin_id",
          "data_release_id",
          "bundle_hash",
          "order"
        ],
        "properties": {
          "data_plugin_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
          },
          "data_release_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bundle_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "order": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "constraints": {
      "type": "array"
    },
    "exemplar_hashes": {
      "type": "array"
    }
  }
}
