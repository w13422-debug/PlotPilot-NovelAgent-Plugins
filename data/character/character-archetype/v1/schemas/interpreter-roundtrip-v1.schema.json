{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "character-archetype-interpreter-roundtrip/v1"
    },
    "format_id": {
      "const": "character-archetype/v1"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "forward_direction": {
      "const": "format_to_capability"
    },
    "reverse_direction": {
      "const": "capability_to_format"
    }
  },
  "required": [
    "schema",
    "format_id",
    "capabilities",
    "forward_direction",
    "reverse_direction"
  ]
}
