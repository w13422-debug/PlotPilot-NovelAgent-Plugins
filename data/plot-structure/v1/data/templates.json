        {
          "beat_id": "resolution",
          "label_zh": "结果与余波",
          "order": 70,
          "target_level": "chapter",
          "purpose": "展示后果并闭合或延续线索",
          "required": true
        }
      ],
      "constraints": {
        "ordered": true,
        "allow_optional_beats": true,
        "requires_evidence_closure": true,
        "authority": "template_only"
