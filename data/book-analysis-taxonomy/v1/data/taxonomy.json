    {"key": "punctuation_habits", "label_zh": "标点习惯", "value_type": "text_profile", "allowed_values": []}
  ],
  "review_rubric": [
    {"criterion_id": "exact_evidence", "label_zh": "精确证据", "applies_to": "atom", "requirement": "每个事实性 Atom 至少引用一个 exact Revision 的 Unicode code-point EvidenceSpan；quote、quote_hash、canonical_text_hash 必须可重算。", "failure_code": "evidence_not_exact"},
    {"criterion_id": "atomicity", "label_zh": "最小可判断性", "applies_to": "atom", "requirement": "一个 Atom 只表达一个可独立接受或拒绝的观察或技法。", "failure_code": "not_atomic"},
    {"criterion_id": "taxonomy_fit", "label_zh": "分类闭合", "applies_to": "atom", "requirement": "atom_kind、描写类型、叙述方式及量化字段只能取本 taxonomy 声明的键和值。", "failure_code": "taxonomy_mismatch"},
    {"criterion_id": "observation_interpretation_split", "label_zh": "观察与解释分离", "applies_to": "atom", "requirement": "observation 只陈述证据可见内容；interpretation 单独标记推断置信度。", "failure_code": "observation_interpretation_mixed"},
    {"criterion_id": "applicability_limits", "label_zh": "适用性与限制", "applies_to": "both", "requirement": "结论说明适用主体或章节、适用范围和已知限制，不把局部样本外推为全书真理。", "failure_code": "scope_or_limits_missing"},
    {"criterion_id": "provenance_complete", "label_zh": "运行来源完整", "applies_to": "both", "requirement": "保留生成 Skill、模型、Code plugin、RunSnapshot 和 exact Source Revision 反链；人工 Atom 仍需 producer_kind=human 的零模型 provenance。", "failure_code": "provenance_incomplete"},
    {"criterion_id": "accepted_current_atoms_only", "label_zh": "仅接受当前 Atom", "applies_to": "claim", "requirement": "Claim 只能按冻结顺序引用同一 Source Revision 上 accepted 且 current 的 Atom、payload_hash、acceptance_ordinal 和 EvidenceSpan。", "failure_code": "atom_authority_invalid"},
    {"criterion_id": "claim_input_order", "label_zh": "Claim 输入顺序闭合", "applies_to": "claim", "requirement": "claim-input/v1 ordinal 从 0 连续，禁止缺失、重复、重排、跨 Revision 或 Asset/hash 漂移。", "failure_code": "claim_input_invalid"},
    {"criterion_id": "counterevidence", "label_zh": "反例与冲突", "applies_to": "claim", "requirement": "Claim 显式保存 counterexamples、conflicts 和 interpretation_confidence；冲突不得被综合成无来源真相。", "failure_code": "counterevidence_omitted"},
    {"criterion_id": "rereview_non_mutating", "label_zh": "复审不直改当前权威", "applies_to": "both", "requirement": "re-review 只产生 diagnostic-bundle/v1；任何修订必须另建 Candidate 并由 Core 决策和 Publication。", "failure_code": "rereview_mutated_authority"}
  ],
