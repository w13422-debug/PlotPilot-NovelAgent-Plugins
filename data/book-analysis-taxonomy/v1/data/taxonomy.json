  "structure_metrics": [
    {"key": "chapter_ending", "label_zh": "章节结尾方式", "value_type": "categorical", "allowed_values": ["hook", "cliffhanger", "resolution", "revelation", "transition", "open"]},
    {"key": "sentence_length", "label_zh": "句式长短", "value_type": "codepoint_distribution", "allowed_values": []},
    {"key": "paragraph_length", "label_zh": "段落长度", "value_type": "codepoint_distribution", "allowed_values": []},
