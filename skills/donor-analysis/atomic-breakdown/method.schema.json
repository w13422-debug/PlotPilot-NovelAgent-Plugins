{
  "$id": "https://plotpilot.local/skills/donor-skill-method-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "donor-skill-method/v1"},
    "skill_id": {"enum": ["com.plotpilot.skill.donor.atomic-breakdown", "com.plotpilot.skill.donor.claim-synthesis"]},
    "input_format_id": {"const": "book-analysis-taxonomy/v1"},
    "capability_ids": {
      "type": "array",
      "items": {"enum": ["analysis.book.atom.extract/v1", "analysis.book.atom.manual/v1", "analysis.book.claim.generate/v1"]},
      "minItems": 1,
      "uniqueItems": true
    },
    "result_contract": {"const": "candidate-batch/v1"},
    "rules": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
      "minItems": 1,
      "uniqueItems": true
    },
    "authority": {"const": "candidate_only"}
  },
  "required": ["schema", "skill_id", "input_format_id", "capability_ids", "result_contract", "rules", "authority"]
}

